{
  "openapi": "3.1.0",
  "info": {
    "title": "ScrapersHub API - TikTok Top Ads, Shopee SEA Pricing & B2B Leads",
    "description": "Enterprise-grade scraping & intelligence Micro-SaaS. Provides 3 unified endpoints for TikTok Top Ads creative performance, Shopee Southeast Asia live pricing & sales velocity, and B2B local business leads.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Health Check & System Status",
        "description": "Returns service availability, active version, current timestamp, and registered endpoints.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tiktok/top-ads": {
      "get": {
        "tags": [
          "TikTok Ads"
        ],
        "summary": "Discover TikTok Top Performing Ads",
        "description": "Extract high-converting TikTok Top Ad creatives with full engagement metrics (CTR, CVR, likes, shares), landing page destinations, and video assets across multiple countries and vertical industries.",
        "operationId": "get_tiktok_top_ads_api_v1_tiktok_top_ads_get",
        "parameters": [
          {
            "name": "country",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 5,
              "description": "2-letter ISO country code (e.g. US, VN, SG, GB, ID, TH, MY)",
              "examples": [
                "US"
              ],
              "default": "US",
              "title": "Country"
            },
            "description": "2-letter ISO country code (e.g. US, VN, SG, GB, ID, TH, MY)"
          },
          {
            "name": "industry",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Industry filter (e.g. Beauty & Personal Care, Electronics, Fashion, E-Commerce, App & Games)",
              "examples": [
                "Beauty & Personal Care"
              ],
              "title": "Industry"
            },
            "description": "Industry filter (e.g. Beauty & Personal Care, Electronics, Fashion, E-Commerce, App & Games)"
          },
          {
            "name": "objective",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Campaign objective (e.g. Conversions, Traffic, Lead Generation, Reach)",
              "examples": [
                "Conversions"
              ],
              "title": "Objective"
            },
            "description": "Campaign objective (e.g. Conversions, Traffic, Lead Generation, Reach)"
          },
          {
            "name": "period",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 180,
              "minimum": 7,
              "description": "Lookback window in days (7, 30, or 180)",
              "examples": [
                30
              ],
              "default": 30,
              "title": "Period"
            },
            "description": "Lookback window in days (7, 30, or 180)"
          },
          {
            "name": "sort_by",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(like|ctr|cvr|shares|impressions)$",
              "description": "Rank sorting criteria: 'like', 'ctr', 'cvr', 'shares', 'impressions'",
              "examples": [
                "like"
              ],
              "default": "like",
              "title": "Sort By"
            },
            "description": "Rank sorting criteria: 'like', 'ctr', 'cvr', 'shares', 'impressions'"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "description": "Results per page (min: 1, max: 50)",
              "examples": [
                10
              ],
              "default": 10,
              "title": "Limit"
            },
            "description": "Results per page (min: 1, max: 50)"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Page index offset (min: 1)",
              "examples": [
                1
              ],
              "default": 1,
              "title": "Page"
            },
            "description": "Page index offset (min: 1)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TikTokTopAdsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Pydantic validation failure"
          }
        }
      }
    },
    "/api/v1/shopee/pricing": {
      "get": {
        "tags": [
          "Shopee E-Commerce"
        ],
        "summary": "Scrape Shopee SEA Product Pricing & Benchmarks",
        "description": "Scrape real-time product prices, historical sales velocity, review ratings, and discount rates across Southeast Asian Shopee marketplaces (Vietnam, Singapore, Malaysia, Thailand, Philippines, Indonesia).",
        "operationId": "get_shopee_pricing_api_v1_shopee_pricing_get",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 100,
              "description": "Target search keywords (e.g. 'wireless headphones', 'skincare serum')",
              "examples": [
                "wireless headphones"
              ],
              "title": "Query"
            },
            "description": "Target search keywords (e.g. 'wireless headphones', 'skincare serum')"
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 5,
              "description": "Shopee SEA country code: VN, SG, MY, TH, PH, ID, BR",
              "examples": [
                "VN"
              ],
              "default": "VN",
              "title": "Country"
            },
            "description": "Shopee SEA country code: VN, SG, MY, TH, PH, ID, BR"
          },
          {
            "name": "sort_by",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(sales|relevance|price_asc|price_desc|rating)$",
              "description": "Sort ranking: 'sales', 'relevance', 'price_asc', 'price_desc', 'rating'",
              "examples": [
                "sales"
              ],
              "default": "sales",
              "title": "Sort By"
            },
            "description": "Sort ranking: 'sales', 'relevance', 'price_asc', 'price_desc', 'rating'"
          },
          {
            "name": "min_price",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Minimum price threshold in target market currency",
              "examples": [
                100000.0
              ],
              "title": "Min Price"
            },
            "description": "Minimum price threshold in target market currency"
          },
          {
            "name": "max_price",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Maximum price threshold in target market currency",
              "examples": [
                2000000.0
              ],
              "title": "Max Price"
            },
            "description": "Maximum price threshold in target market currency"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "description": "Results per page (min: 1, max: 50)",
              "examples": [
                10
              ],
              "default": 10,
              "title": "Limit"
            },
            "description": "Results per page (min: 1, max: 50)"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Page index offset (min: 1)",
              "examples": [
                1
              ],
              "default": 1,
              "title": "Page"
            },
            "description": "Page index offset (min: 1)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShopeePricingResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid price boundary filter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Pydantic validation failure"
          }
        }
      }
    },
    "/api/v1/b2b/leads": {
      "get": {
        "tags": [
          "B2B Local Leads"
        ],
        "summary": "Extract Local B2B Business Leads & Contact Info",
        "description": "Discover targeted local commercial leads filtered by niche and geography. Extracts phone numbers, verified emails, domains, social profiles, review ratings, and coordinates.",
        "operationId": "get_b2b_leads_api_v1_b2b_leads_get",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 100,
              "description": "Business industry or specialty keywords (e.g. 'marketing agency', 'dental clinic')",
              "examples": [
                "marketing agency"
              ],
              "title": "Query"
            },
            "description": "Business industry or specialty keywords (e.g. 'marketing agency', 'dental clinic')"
          },
          {
            "name": "location",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 100,
              "description": "Target city or metro region (e.g. 'Ho Chi Minh City', 'Austin, TX', 'Singapore')",
              "examples": [
                "Ho Chi Minh City"
              ],
              "title": "Location"
            },
            "description": "Target city or metro region (e.g. 'Ho Chi Minh City', 'Austin, TX', 'Singapore')"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "description": "Results per page (min: 1, max: 50)",
              "examples": [
                10
              ],
              "default": 10,
              "title": "Limit"
            },
            "description": "Results per page (min: 1, max: 50)"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Page index offset (min: 1)",
              "examples": [
                1
              ],
              "default": 1,
              "title": "Page"
            },
            "description": "Page index offset (min: 1)"
          },
          {
            "name": "has_website",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter for businesses with an active verified website",
              "examples": [
                true
              ],
              "title": "Has Website"
            },
            "description": "Filter for businesses with an active verified website"
          },
          {
            "name": "has_phone",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter for businesses with a direct phone number",
              "examples": [
                true
              ],
              "title": "Has Phone"
            },
            "description": "Filter for businesses with a direct phone number"
          },
          {
            "name": "min_rating",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 5.0,
                  "minimum": 0.0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Minimum review rating filter (0.0 - 5.0)",
              "examples": [
                4.5
              ],
              "title": "Min Rating"
            },
            "description": "Minimum review rating filter (0.0 - 5.0)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/B2BLeadsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Pydantic validation failure"
          }
        }
      }
    }
  },
